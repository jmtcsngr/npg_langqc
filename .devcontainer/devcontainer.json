// npg_langqc devcontainer configuration (GitHub Codespaces target).
// The editor attaches to the `workspace` service; the application runs as a set
// of compose services (two MySQLs, backend, frontend, Apache proxy). See
// docker-compose.yml and README.md.
//
// Generated by:    Claude Opus 4.8 (1M context)
// Generation date: 2026-07-31
// Last modified by: Claude Opus 4.8 (1M context)
// Last modified:    2026-08-13
{
  "name": "npg_langqc",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Node is provided as a devcontainer feature; Python 3.14 comes from the base image.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },

  // Runs on the host before the build: creates frontend/.env (needed at build time).
  "initializeCommand": "bash .devcontainer/init_frontend_env.sh",

  // Runs once after the container is created: installs backend + frontend deps.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [8443, 8080, 8181, 3306, 3307],
  "portsAttributes": {
    // 8443 is the app entry. `protocol: http` is REQUIRED — 8443 is a
    // conventional HTTPS port, so Codespaces otherwise assumes TLS and 502s
    // against our plain-HTTP proxy. Auto-open it so the right URL launches.
    "8443": { "label": "LangQC app (open this)", "onAutoForward": "openBrowser", "protocol": "http" },
    "8080": { "label": "frontend only (no /api)", "onAutoForward": "silent", "protocol": "http" },
    "8181": { "label": "backend API only", "onAutoForward": "silent", "protocol": "http" },
    "3306": { "label": "MLWH MySQL", "onAutoForward": "silent" },
    "3307": { "label": "QC MySQL", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "Vue.volar",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  }
}
