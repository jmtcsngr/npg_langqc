// npg_langqc devcontainer configuration (GitHub Codespaces target).
// Step 1 scaffolding: a single `workspace` service where the editor attaches.
// Database, backend, frontend and proxy services are added in later steps.
//
// Generated by:    Claude Opus 4.8 (1M context)
// Generation date: 2026-07-31
{
  "name": "npg_langqc",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Node is provided as a devcontainer feature; Python 3.10 comes from the base image.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },

  // Runs once after the container is created: installs backend + frontend deps.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Database ports forwarded so a host DB client (DBeaver, etc.) can connect.
  "forwardPorts": [3306, 3307],
  "portsAttributes": {
    "3306": { "label": "MLWH MySQL", "onAutoForward": "silent" },
    "3307": { "label": "QC MySQL", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "Vue.volar",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  }
}
